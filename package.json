{
  "name": "clickup-mcp-read",
  "version": "1.0.0",
  "description": "Strictly read-only ClickUp MCP server. Wraps @twofeetup/clickup-mcp, removes every write path, and adds get_task_tree and get_task_activity.",
  "type": "module",
  "bin": {
    "clickup-mcp-read": "src/index.mjs"
  },
  "main": "src/index.mjs",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@twofeetup/clickup-mcp": "^1.7.0"
  },
  "keywords": [
    "clickup",
    "mcp",
    "model-context-protocol",
    "read-only",
    "subtasks",
    "task-management",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breckenreed/clickup-mcp-read.git"
  },
  "bugs": {
    "url": "https://github.com/breckenreed/clickup-mcp-read/issues"
  },
  "homepage": "https://github.com/breckenreed/clickup-mcp-read#readme",
  "license": "MIT"
}
